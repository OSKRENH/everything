{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kutno",
  "main": "worker/next-entry.js",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    {
      "pattern": "kutno.ru",
      "custom_domain": true
    },
    {
      "pattern": "www.kutno.ru",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "run_worker_first": [
      "/api/*",
      "/img/*",
      "/recipes",
      "/recipes/*",
      "/recipe/*",
      "/robots.txt",
      "/sitemap.xml",
      "/lite",
      "/lite/*"
    ]
  },
  "ai": {
    "binding": "AI"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kutno-users",
      "database_id": "d85a82b2-6dd0-4bb9-9539-677f049697d4",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "GOOGLE_CLIENT_ID": "117547932468-r7j3rtk0b00va7o687gqn7he18cbuir2.apps.googleusercontent.com"
  },
  "env": {
    "preview": {
      "vars": {
        "STRICT_SEO_MARKERS": "true"
      }
    }
  },
  "secrets": {
    "required": ["YANDEX_CLIENT_ID", "YANDEX_CLIENT_SECRET"]
  },
  "observability": {
    "enabled": true
  }
}
