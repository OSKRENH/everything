{
  "name": "kutno",
  "main": "./client/dist/_worker.js/index.js",
  "compatibility_date": "2024-11-01",
  "assets": {
    "directory": "./client/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kutno-db",
      "database_id": "4f513285-291f-4c05-84e3-c232068e0b57"
    }
  ]
}
