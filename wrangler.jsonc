{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kutno",
  "main": "worker/index.js",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "ai": {
    "binding": "AI"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kutno-users"
    }
  ],
  "vars": {
    "GOOGLE_CLIENT_ID": "117547932468-r7j3rtk0b00va7o687gqn7he18cbuir2.apps.googleusercontent.com"
  },
  "observability": {
    "enabled": true
  }
}
